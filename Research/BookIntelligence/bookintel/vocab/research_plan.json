{
  "_comment": "What the corpus should contain, and how to search for what it lacks. `gaps` compares the corpus against `targets` and fills `query_templates` for every shortfall. Targets count WORKS, never editions. Raise them as the corpus grows; they are a research plan, not a quality bar.",
  "primary": {
    "age_band": "5-6",
    "languages": [
      "en",
      "tr"
    ]
  },
  "targets": {
    "analyzed_full_per_primary_language": 10,
    "analyzed_per_age_band": {
      "3-4": 5,
      "5-6": 20,
      "7-8": 5,
      "9-10": 5
    },
    "page_turn_eligible_in_primary_band": 10,
    "per_story_type_in_primary_band": 3,
    "per_tone_in_primary_band": 2,
    "per_structure_in_primary_band": 2,
    "contemporary_min_year": 1990,
    "contemporary_share_min": 0.8,
    "female_protagonist_share_min": 0.3,
    "visual_analysis_share_min": 0.5,
    "languages_min": 4
  },
  "story_types_of_interest": [
    "adventure",
    "friendship",
    "courage",
    "bedtime",
    "family",
    "funny",
    "discovery",
