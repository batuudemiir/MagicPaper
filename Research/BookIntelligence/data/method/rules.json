    },
    {
      "rule_id": "m003",
      "kind": "note",
      "text": "Tekrar önerileri genel tekrar kapısını (5-gram, RepetitionValidator) gevşetmez; yalnızca blueprint'te ilan edilmiş, katılınabilir, olumlu ya da nötr bir nakarat önerilir.",
      "pattern": null,
