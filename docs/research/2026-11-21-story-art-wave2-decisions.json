  "additionalSources": [
    {
      "sourceID": "s34_na_01",
      "templateID": "corpus_3-4_notice_anomaly",
      "sourceTextDigest": "c12f260ca5fe32ed",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age3/beat_age3_notice_anomaly.json",
      "text": "Yerde {{discovery.name}} duruyordu. Kimindi bu?",
      "textSHA256": "1500208e8cb69edf8d5bee0ba1c72c58319b0057b23301b6b32acc41ab2dfbbd",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "s34_na_02",
      "templateID": "corpus_3-4_notice_anomaly",
      "sourceTextDigest": "95b481638e591ced",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age3/beat_age3_notice_anomaly.json",
      "text": "{{child.name}} bir şey gördü: {{discovery.name}}.",
      "textSHA256": "4707cb234cadbf7a7a01b77c562d2be729e49749bff9ab9ab95a80b40cb8e2b6",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "s34_na_tp_01",
      "templateID": "corpus_3-4_notice_anomaly",
      "sourceTextDigest": "102912693272297c",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age3/beat_age3_notice_anomaly.json",
      "text": "Yolun kenarında {{discovery.name}} vardı. {{child.name}} yaklaştı.",
      "textSHA256": "c41e05ba4904822f8a00c07ecbf6f057f09341aea2443a2f3c489a2092b28a21",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "na_neutral_03",
      "templateID": "corpus_5-6_notice_anomaly",
      "sourceTextDigest": "618634e5ad6d6d17",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3/beat_notice_anomaly.json",
      "text": "{{child.name}} {{setting.name}}'da yürürken ayakları kendiliğinden durdu. Böyle bir şeyi daha önce hiç görmemişti. {{discovery.name}} tam oradaydı, apaçık.",
      "textSHA256": "2a0283248a39ba20ff8fe8d945890d5362bd3326d312df1ef4feb3dc7670a3ae",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "na_neutral_04",
      "templateID": "corpus_5-6_notice_anomaly",
      "sourceTextDigest": "673eb935a28a512d",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3/beat_notice_anomaly.json",
      "text": "Her gün aynı yoldan geçerdi {{child.name}}. Ama bugün {{setting.name}} bambaşkaydı. Yolun tam ortasında {{discovery.name}} duruyor, onu bekliyordu.",
      "textSHA256": "64502d3e33060ff13c5f15ead3575490559009f260d62b83c4df4af0a147bcdd",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "na_neutral_05",
      "templateID": "corpus_5-6_notice_anomaly",
      "sourceTextDigest": "c32f7ca2d098219a",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3/beat_notice_anomaly.json",
      "text": "{{child.name}} {{setting.name}}'a vardığında içinden bir ses \"dur\" dedi. Sebebini önce anlamadı. Olduğu yerde biraz bekledi. Sonra {{discovery.name}} gözüne çarptı.",
      "textSHA256": "1c068d54dd204f362d14d7a554c448ec4546dcadcf69a520842a768e9e2ca0b2",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "a7_na_03",
      "templateID": "corpus_7-8_notice_anomaly",
      "sourceTextDigest": "0b88d501e2ed246b",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age7/beat_age7_notice_anomaly.json",
      "text": "{{child.name}} {{setting.name}}'da bir saattir sıkılıyordu. Sıkılmak bile sıkıcı gelmeye başlamıştı. Tam eve dönecekti ki {{discovery.name}} dikkatini çekti. Sıkıntısı bir anda uçup gitti.",
      "textSHA256": "b17ba800b85cb0ef2f11c70844d47f42e107ff916753fda5c1cb0df8c6922256",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "a7_na_04",
      "templateID": "corpus_7-8_notice_anomaly",
      "sourceTextDigest": "ea3fe68d56f32772",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age7/beat_age7_notice_anomaly.json",
      "text": "{{setting.name}} her zamanki kadar sessizdi. {{child.name}} ise her zamanki kadar meraklıydı. Bu yüzden {{discovery.name}} onun dikkatinden kaçmadı. Kimse fark etmemişti, ama o fark etti.",
      "textSHA256": "f75e34ef763457dd2d9e146e832e34f67562079427473419ee2dd4add545beae",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "a7_na_05",
      "templateID": "corpus_7-8_notice_anomaly",
      "sourceTextDigest": "8bfab639b8b1c69e",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age7/beat_age7_notice_anomaly.json",
      "text": "{{child.name}} bir şeyi sormadan önce hep iki kez düşünürdü. Ama {{setting.name}}'da {{discovery.name}} ile karşılaşınca düşünmeyi unuttu. Olduğu yerde kalakaldı. Bu da neydi şimdi?",
      "textSHA256": "300ffd218092b92ebff2df2b8c00bd1438bf2b6815dd5ed9a2d31fc00433881e",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "a7_na_07",
      "templateID": "corpus_7-8_notice_anomaly",
      "sourceTextDigest": "772f2e2dbbd5f206",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age7/beat_age7_notice_anomaly.json",
      "text": "{{child.name}} gözlerini kısıp baktı, sonra bir daha baktı. Gözleri ona oyun oynamıyordu. {{setting.name}}'da, yolun tam kenarında {{discovery.name}} duruyordu. Bunun bir açıklaması olmalıydı.",
      "textSHA256": "7713bb1722abdc6b0b7f95cbc8f1010e710ff205492c8f16cc557131ac00fdbd",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "a9_na_01",
      "templateID": "corpus_9-10_notice_anomaly",
      "sourceTextDigest": "f1819cecdab76fd2",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age9/beat_age9_notice_anomaly.json",
      "text": "{{child.name}} o sabah {{setting.name}}'a yalnızca biraz kafa dinlemek için gelmişti. Planı basitti: oturmak, etrafı izlemek, hiçbir şey düşünmemek. Plan tam dört dakika sürdü. Çünkü {{discovery.name}} oradaydı ve dün aynı yere baktığında orada hiçbir şey yoktu.",
      "textSHA256": "c49a238c19e5dd902b5856c1c2e6a21594eb218dd183c76cbcc86f1aeffd193e",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "a9_na_02",
      "templateID": "corpus_9-10_notice_anomaly",
      "sourceTextDigest": "0b617ea3647b1663",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age9/beat_age9_notice_anomaly.json",
      "text": "{{child.name}}'in tuhaf bir yeteneği vardı: bir yerde neyin değiştiğini, ne olduğunu anlamadan önce sezerdi. {{setting.name}}'a adımını atar atmaz o tanıdık kıpırtıyı hissetti. Gözleri yavaşça dolaştı ve sonunda durdu. {{discovery.name}}, sanki hep oradaymış gibi duruyordu.",
      "textSHA256": "90ceebdb834fe198e661b28a78b526ad8e7a6b210dcf0b78925833d67b0eff45",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "a9_na_04",
      "templateID": "corpus_9-10_notice_anomaly",
      "sourceTextDigest": "0922e1a8bcaab5d1",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age9/beat_age9_notice_anomaly.json",
      "text": "{{child.name}} sorular sormayı severdi, cevaplardan bile çok. {{setting.name}}'da {{discovery.name}} dikkatini çekince kafasında aynı anda üç soru belirdi. Ne zaman gelmişti, nereden gelmişti, neden tam buradaydı? Üçünün de cevabı yoktu ve bu, günün en güzel haberiydi.",
      "textSHA256": "48b45f76ded98fed0994a14d72f2d20eab989bcf6f64825c1b6dabee255f63db",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "a9_na_05",
      "templateID": "corpus_9-10_notice_anomaly",
      "sourceTextDigest": "77c9ebf8c82f85b4",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age9/beat_age9_notice_anomaly.json",
      "text": "Bazı günler sıradan başlar ve sıradan devam edecekmiş gibi görünür. {{child.name}} için o gün de öyleydi, ta ki {{setting.name}}'da {{discovery.name}} dikkatini çekene kadar. {{child.name}} adımlarını yavaşlattı. Sıradan günlerin en sevdiği yanı buydu: arada bir sıradan olmaktan vazgeçmeleri.",
      "textSHA256": "d08322d6bdfe11b08895fe9f6362fa95f70a0b15088835b34d488b682d694d2e",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "a9_na_07",
      "templateID": "corpus_9-10_notice_anomaly",
      "sourceTextDigest": "6cd3f854f82469c9",
      "decision": "discovery_present",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age9/beat_age9_notice_anomaly.json",
      "text": "Bir kitapta okumuştu: dikkatli bakan göz, her şeyi iki kez görür. {{child.name}} o gün bunun ne demek olduğunu anladı. {{setting.name}}'da herkesin yanından geçip gittiği yerde {{discovery.name}} duruyordu. Bir kez gördü, sonra durup bir kez daha baktı.",
      "textSHA256": "9d196c03675e74f1fe46ba56ff7c49cb06936783a5d6a378bbee79a5ad2700a7",
      "review": "Explicit physically present named discovery. Isolated object only; no scene or action authorization."
    },
    {
      "sourceID": "mc3u_01",
      "templateID": "corpus_3-4_meet_companion",
      "sourceTextDigest": "7adcbcd50d309c3e",
      "decision": "no_discovery_contradiction",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age3/beat_age3_meet_companion.json",
      "text": "O sırada {{companion.name}} geldi. O da merakla baktı.",
      "textSHA256": "c60bfdbed34404b2deb8f96747b1529f6118a12a8cdb7c5aacc54dd163aa8c5b",
      "review": "Paired trailing companion greeting/observation only. No discovery change; no companion art authorized."
    },
    {
      "sourceID": "mc3u_04",
      "templateID": "corpus_3-4_meet_companion",
      "sourceTextDigest": "fd00c1ee2f8361e5",
      "decision": "no_discovery_contradiction",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age3/beat_age3_meet_companion.json",
      "text": "{{companion.name}} yaklaştı. \"Ne var orada?\" diye sordu.",
      "textSHA256": "2d5817720268a27c958bff9678216e99c9d605815444f025f144dd6ebc0c97f5",
      "review": "Paired trailing companion greeting/observation only. No discovery change; no companion art authorized."
    },
    {
      "sourceID": "mc3u_05",
      "templateID": "corpus_3-4_meet_companion",
      "sourceTextDigest": "e0948899956f2eea",
      "decision": "no_discovery_contradiction",
      "path": "StoryEngine/Sources/StoryEngine/Resources/templates/v3-age3/beat_age3_meet_companion.json",
