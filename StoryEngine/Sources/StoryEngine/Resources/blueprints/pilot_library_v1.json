  "templates": [
    {
      "id": "pilot_t_notice_anomaly",
      "role": "hook",
      "realizesBeat": "notice_anomaly",
      "compatibleThemes": [
        "courage"
      ],
      "variants": [
        {
          "id": "pilot_t_notice_anomaly_v1",
          "text": "Güneşli bir sabah, {{child.name}} {{setting.name}}'nin yakınında dolaşıyordu. Tam dönecekken, orada olmaması gereken bir şey fark etti: {{discovery.name}}.",
          "visualScene": "child pausing mid-step at the edge of the place, something faint further in"
        },
        {
          "id": "pilot_t_notice_anomaly_v2",
          "text": "Kuşların şarkı söylediği o gün, {{child.name}} durdu ve dikkatle baktı. {{setting.name}}'nin ilerisinde {{discovery.name}} vardı. Acaba oraya nereden gelmişti?",
          "visualScene": "child shading their eyes, looking toward something small and unexplained"
        },
        {
          "id": "pilot_t_notice_anomaly_v3",
          "text": "{{child.name}} her zamanki yoluna gidiyordu ki bir şey onu durdurdu. {{setting.name}}'nin öte yanında {{discovery.name}} vardı ve daha önce hiç orada yoktu.",
          "visualScene": "an ordinary path, and one thing on it that does not belong"
        }
      ]
    },
    {
      "id": "pilot_t_approach",
      "role": "discovery",
      "realizesBeat": "approach",
      "compatibleThemes": [
        "courage"
      ],
      "variants": [
        {
          "id": "pilot_t_approach_v1",
          "text": "{{child.name}} bir adım yaklaştı, sonra bir adım daha. Yaklaştıkça {{discovery.name}} daha da belirginleşti.",
          "visualScene": "child moving closer, the thing clearer now"
        },
        {
          "id": "pilot_t_approach_v2",
          "text": "Merakına engel olamadı. {{child.name}} yavaşça {{setting.name}}'ne doğru yürüdü ve {{discovery.name}}'i daha yakından fark etti.",
          "visualScene": "slow approach, warm light"
        },
        {
